# Copy this file to .env before running Docker Compose.
# All secrets and deployment-specific values should live in .env, not in source files.

# PostgreSQL database created by the official postgres image on first startup.
POSTGRES_DB=cloudpaste
POSTGRES_USER=cloudpaste
POSTGRES_PASSWORD=change_this_strong_password

# Internal PostgreSQL port. Do not publish this port to the host.
DB_PORT=5432

# Allowed browser origin for CORS. Use * for local demos behind the same reverse proxy.
CORS_ORIGIN=*

# bcrypt password hashing cost. 12 is a reasonable default for demos and small deployments.
BCRYPT_ROUNDS=12
